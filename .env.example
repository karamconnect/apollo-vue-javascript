# Better Auth server base URL (including /api/auth). Leave unset to use the in-browser mock, which accepts any password.
# VITE_AUTH_URL=https://api.example.com/api/auth

# Filestack API key for photo uploads (https://dev.filestack.com). Leave unset to use Filestack's shared demo key.
# Add your app's domains (and http://localhost:5173) to the key's allowed origins in the Filestack dashboard.
# VITE_FILESTACK_API_KEY=your-api-key
