# Better Auth server base URL (including /api/auth). Leave unset to use the in-browser mock, which accepts any password.
# VITE_AUTH_URL=https://api.example.com/api/auth

# Filestack API key for photo uploads (https://dev.filestack.com). Leave unset to use Filestack's shared demo key.
# Add your app's domains (and http://localhost:5173) to the key's allowed origins in the Filestack dashboard.
# VITE_FILESTACK_API_KEY=your-api-key

# Flagsmith environment ID (client-side key) for feature flags. Leave unset to use the defaults in src/flags/index.js.
# VITE_FLAGSMITH_ENVIRONMENT_ID=your-environment-id

# Tolgee (https://tolgee.io): in-context translation in `npm run dev` (Alt + click a text) and `npm run i18n:push|pull`.
# Use a project API key. It is only read in development and by the CLI, never bundled by `npm run build`.
# The key needs keys.view/create/edit and translations.view/edit (plus screenshots.* for screenshots).
# VITE_APP_TOLGEE_API_URL=https://app.tolgee.io
# VITE_APP_TOLGEE_API_KEY=tgpak_your-project-api-key

# Tolgee Content Delivery URL (public, no key): in production builds, published translations are fetched from
# <url>/<lang>.json and layered over the bundled locale files, so reviewed texts go live without a deploy.
# VITE_TOLGEE_CDN_URL=https://cdn.tolg.ee/2ca9a69042efd7511c5920e178707716
