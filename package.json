{
    "name": "apollo-vue",
    "version": "7.0.0",
    "private": true,
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint src scripts .eslintrc.cjs vite.config.mjs tailwind.config.js --ext .vue,.js,.jsx,.cjs,.mjs,.json --fix --ignore-path .gitignore",
        "lint:check": "eslint src scripts .eslintrc.cjs vite.config.mjs tailwind.config.js --ext .vue,.js,.jsx,.cjs,.mjs,.json --ignore-path .gitignore",
        "format": "prettier --write \"**/*.{js,vue,d.ts}\"",
        "i18n:push": "node scripts/tolgee.mjs push",
        "i18n:pull": "node scripts/tolgee.mjs pull && prettier --write src/i18n/locales"
    },
    "dependencies": {
        "@flagsmith/flagsmith": "^12.4.0",
        "@primeuix/themes": "^2.0.0",
        "@primevue/forms": "^4.5.4",
        "@vueuse/core": "^15.0.0",
        "@vueuse/integrations": "^15.0.0",
        "better-auth": "^1.7.7",
        "chart.js": "^4.3.0",
        "filestack-js": "^4.3.9",
        "flagsmith-vue": "^3.1.0",
        "fuse.js": "^7.5.0",
        "libphonenumber-js": "^1.13.15",
        "pinia": "^4.1.0",
        "primeicons": "^7.0.0",
        "primelocale": "^2.6.0",
        "primevue": "^4.5.4",
        "tailwindcss-primeui": "^0.6.1",
        "vue": "^3.4.29",
        "vue-i18n": "^11.4.14",
        "vue-router": "^4.3.3",
        "vue-tel-input": "^9.9.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@intlify/eslint-plugin-vue-i18n": "^3.2.0",
        "@primevue/auto-import-resolver": "^4.3.1",
        "@rushstack/eslint-patch": "^1.8.0",
        "@tailwindcss/vite": "^4.1.17",
        "@tolgee/cli": "^2.21.0",
        "@tolgee/web": "^7.3.0",
        "@vitejs/plugin-vue": "^5.0.5",
        "@vue/eslint-config-prettier": "^9.0.0",
        "@vue/test-utils": "^2.5.1",
        "eslint": "^8.57.0",
        "eslint-plugin-vue": "^9.23.0",
        "jsdom": "^29.1.1",
        "jsonc-eslint-parser": "^2.4.2",
        "prettier": "^3.2.5",
        "sass": "1.62.1",
        "tailwindcss": "^4.1.17",
        "typescript": "~5.9.3",
        "unplugin-vue-components": "^0.27.3",
        "vite": "^5.3.1",
        "vitest": "^3.2.7"
    }
}
